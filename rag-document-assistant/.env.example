# Model provider
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
LLM_MODEL=your-chat-model
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSION=768

# Local PostgreSQL + pgvector
POSTGRES_DB=rag_credit
POSTGRES_USER=rag_app
POSTGRES_PASSWORD=rag_app_local
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://rag_app:rag_app_local@localhost:55432/rag_credit

# Original PDF storage: local for development, s3 for deployment
ORIGINAL_PDF_STORAGE_BACKEND=local
# ORIGINAL_PDF_LOCAL_ROOT=/absolute/path/to/persistent/originals
# ORIGINAL_PDF_S3_BUCKET=your-private-bucket
